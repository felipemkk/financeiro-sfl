DATABASE_URL=postgres://lojafiado:lojafiado@localhost:5432/lojafiado
JWT_SECRET=troque-por-uma-string-aleatoria-longa
PORT=8080
FRONTEND_ORIGIN=http://localhost:4200

# Opcional: habilita o contrato de venda a prazo com assinatura eletrônica.
# Gere em https://painel.autentique.com.br/perfil/api — sem isso, o botão
# "Gerar contrato" na tela da venda fica indisponível.
AUTENTIQUE_API_TOKEN=

# Opcional: secret do endpoint de webhook cadastrado no painel da Autentique
# (Configurações > Webhooks), usado para validar que as chamadas em
# /webhooks/autentique realmente vieram de lá. Sem isso, o webhook aceita
# qualquer requisição sem checar a origem.
AUTENTIQUE_WEBHOOK_SECRET=
